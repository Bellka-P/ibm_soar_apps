{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "expired", "deadline", "remaining_seconds", "remaining_text", "html", "type"],
  "properties": {
    "success": {"type": "boolean"},
    "expired": {"type": "boolean"},
    "deadline": {"type": "string"},
    "remaining_seconds": {"type": "integer", "minimum": 0},
    "remaining_text": {"type": "string"},
    "html": {"type": "string"},
    "error": {"type": "string"},
    "type": {"const": "sla_timer"}
  },
  "additionalProperties": false
}
